    "/api/Payments/revenue": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Calculate company revenue from payments within a date range.",
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                  "type": [
                    "number",
                    "string"
                  ],
                  "format": "double"
                }
              },
              "application/json": {
                "schema": {
                  "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                  "type": [
                    "number",
                    "string"
                  ],
                  "format": "double"
                }
              },
              "text/json": {
                "schema": {
                  "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                  "type": [
                    "number",
                    "string"
                  ],
                  "format": "double"
                }
              }
            }
          }
        }
      }
    },
